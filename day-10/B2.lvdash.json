{
  "datasets": [
    {
      "name": "c9a426d8",
      "displayName": "Customer Count by Payment Options Overview",
      "queryLines": [
        "SELECT \n",
        "    payment_method,\n",
        "    COUNT(customer_id) as customers\n",
        "FROM cyntexa_dev.sales.finance_demo\n",
        "GROUP BY payment_method"
      ],
      "catalog": "cyntexa_dev",
      "schema": "sales"
    },
    {
      "name": "c95be85d",
      "displayName": "Customer Sales Amount Summary Dataset",
      "queryLines": [
        "SELECT SUM(amount) AS total_amount, customer_id\n",
        "FROM cyntexa_dev.sales.finance_demo\n",
        "GROUP BY customer_id"
      ],
      "catalog": "cyntexa_dev",
      "schema": "sales"
    },
    {
      "name": "4bc1d4a5",
      "displayName": "Sales Status Overview Report",
      "queryLines": [
        "SELECT status , COUNT(*) as total \n",
        "FROM cyntexa_dev.sales.finance_demo\n",
        "GROUP BY status\n"
      ],
      "catalog": "cyntexa_dev",
      "schema": "sales"
    }
  ],
